{
  "$schema": "./sy.converter-spec.schema.json",
  "id": "sy.evidence-corpus",
  "version": "0.13.0-discovery.1",
  "language": "he",
  "source": {
    "authority": "sefaria_source",
    "canonical_url": "https://www.sefaria.org.il/Sefer_Yetzirah.1.1?lang=he",
    "local_edition": {
      "status": "sealed",
      "file": "src/SeferYetzirah.tsx",
      "sha256": "868e1cadf357fd6b868bfa14d9694e55623186354b1a456dd3a45bb48f4864dd",
      "textual_equivalence": "manually_verified_by_user",
      "niqqud": {
        "status": "authoritative",
        "added_by": "user",
        "purpose": "correct_reading"
      },
      "br_boundaries": {
        "status": "authoritative",
        "added_by": "user",
        "purpose": "correct_reading_boundaries"
      }
    }
  },
  "scope": {
    "allowed_authorities": [
      "sefaria_source",
      "user_interpretation",
      "deterministic_derivation"
    ],
    "excluded_authorities": [
      "external_commentary",
      "model_generated_interpretation"
    ]
  },
  "axiom": {
    "id": "minimal_name_occurrence",
    "statement": "A name occurrence in the source is the minimal representation from which the system is derived.",
    "consequence": "Every observed name is essential regardless of its occurrence count.",
    "authority": "user_interpretation"
  },
  "normalization": {
    "remove_cantillation": true,
    "remove_niqqud": true,
    "remove_punctuation": true,
    "preserve_surface_form": true
  },
  "structure": {
    "chapter_heading": "h2",
    "explicit_unit_heading": "h3",
    "fallback_unit_separator": "jsx_br_pair",
    "discard_headings": ["h1"],
    "minimum_unit_characters": 2,
    "semantic_status": "uninterpreted_input_markup"
  },
  "interpretation": {
    "authority": "user_interpretation_only",
    "roles": [
      "name",
      "operation",
      "entity",
      "number",
      "domain",
      "class",
      "representation",
      "state",
      "relation",
      "category",
      "controller",
      "value"
    ],
    "storage": "local"
  },
  "repetition": {
    "status": "rejected_as_semantic_reader",
    "retained_as": "diagnostic_evidence_only",
    "authority": "assistant_inference",
    "minimum_record_presence_for_anchor": 3,
    "minimum_records_per_slot": 2,
    "ngram_sizes": [2, 3],
    "rules": {
      "repeated_at_aligned_scope": "category_relation_or_controller_candidate",
      "single_unit_presence": "single_unit_value_or_name_candidate",
      "single_global_occurrence": "single_occurrence_value_or_name_candidate",
      "between_repeated_anchors": "slot_value_candidate"
    }
  },
  "terminology": [
    {
      "id": "user_term.double_words",
      "term": "מילים כפולות",
      "language": "he",
      "authority": "user",
      "definition": null,
      "status": "awaiting_user_definition",
      "execution": "forbidden_until_defined",
      "assistant_inferences": [
        {
          "meaning": "words_with_multiple_occurrences",
          "status": "rejected",
          "reason": "not_defined_by_user"
        },
        {
          "meaning": "repeated_ngrams",
          "status": "rejected",
          "reason": "not_defined_by_user"
        },
        {
          "meaning": "frequency_threshold_anchors",
          "status": "rejected",
          "reason": "not_defined_by_user"
        },
        {
          "meaning": "the_explicit_seven_double_letters_category",
          "status": "rejected",
          "reason": "not_defined_by_user"
        }
      ]
    }
  ],
  "capability_registry": [
    { "id": "source.lossless_local_edition", "status": "active" },
    { "id": "source.authoritative_niqqud", "status": "active" },
    { "id": "source.authoritative_br_boundaries", "status": "active" },
    { "id": "corpus.name_occurrences", "status": "active" },
    { "id": "corpus.occurrence_counts", "status": "active" },
    { "id": "corpus.user_interpretations", "status": "active" },
    { "id": "export.complete_json", "status": "active" },
    { "id": "reader.auto_svo", "status": "rejected", "retained_in": "git_history_v0.9" },
    { "id": "reader.frequency_threshold", "status": "rejected", "retained_in": "diagnostic_evidence" },
    { "id": "reader.operation_contracts", "status": "discovery", "retained_in": "git_history_v0.9" },
    { "id": "review.approve_reject_interpretations", "status": "discovery", "retained_in": "git_history_v0.9.1" }
  ],
  "reading_specification": {
    "id": "sy.systemic-reading",
    "version": "0.2.0",
    "states": ["sealed", "discovery", "rejected"],
    "discovery_contract": {
      "status": "sealed",
      "unit_of_approval": "rule_not_instance",
      "requirements": [
        "source_spans_for_every_claim",
        "same_construction_same_parse",
        "all_matches_reported",
        "all_counterexamples_reported",
        "explicit_cardinality_checked",
        "ambiguity_preserved",
        "no_external_semantics",
        "no_unapproved_user_term_expansion"
      ],
      "acceptance": {
        "contradictions": 0,
        "unreported_matches": 0,
        "unsupported_claims": 0
      }
    },
    "sealed_rules": [
      {
        "id": "source.local_edition",
        "statement": "The user-verified local edition is the authoritative working source.",
        "authority": "user_attestation"
      },
      {
        "id": "reading.preserve_niqqud",
        "statement": "Niqqud is authoritative reading information and must not be discarded before linguistic analysis.",
        "authority": "user_interpretation"
      },
      {
        "id": "reading.br_boundary",
        "statement": "Every br marks an authoritative reading boundary; consecutive br elements additionally delimit a reading group.",
        "authority": "user_interpretation"
      },
      {
        "id": "semantics.standard_hebrew",
        "statement": "Standard Hebrew lexical meaning, morphology and syntax are valid derivation sources.",
        "authority": "user_interpretation"
      },
      {
        "id": "scope.no_external_commentary",
        "statement": "Claims not derived from the source, standard Hebrew or the user's interpretation are excluded.",
        "authority": "user_interpretation"
      }
    ],
    "discovery_rules": [
      {
        "id": "declaration.cardinality_noun",
        "pattern": ["cardinality", "following_noun_candidate"],
        "produces": ["cardinality_statement"],
        "status": "discovery"
      },
      {
        "id": "declaration.explicit_member_set",
        "pattern": [
          "cardinality",
          "following_noun_candidate",
          "orthographically_encoded_hebrew_letters",
          "encoded_letter_count_equals_cardinality"
        ],
        "produces": ["category_candidate", "cardinality", "members"],
        "status": "discovery"
      },
      {
        "id": "clause.operation",
        "pattern": ["verb", "arguments", "prepositional_relations"],
        "produces": ["operation", "inputs", "relations", "outputs"],
        "status": "discovery"
      },
      {
        "id": "invariant.cross_unit",
        "pattern": ["repeated_syntactic_structure", "varying_lexical_values"],
        "produces": ["schema", "fields", "values"],
        "status": "discovery"
      }
    ],
    "rejected_rules": [
      {
        "id": "reader.auto_svo.v0_9",
        "reason": "Assumed a linear subject-operation-object reading before establishing Hebrew syntax."
      },
      {
        "id": "reader.frequency_threshold.v0_11",
        "reason": "Assistant incorrectly assigned meanings to the undefined user term 'מילים כפולות' and used arbitrary occurrence thresholds as semantic categories.",
        "authority": "assistant_inference",
        "status": "rejected"
      }
    ]
  },
  "validation": {
    "scope": "structural_and_lossless_only",
    "require_lossless_source": true,
    "require_complete_occurrence_coverage": true,
    "require_name_occurrence_counts": true
  }
}
