{
  "$schema": "./sy.converter-spec.schema.json",
  "id": "sy.converter",
  "version": "0.7.0",
  "language": "he",
  "normalization": {"remove_cantillation": true, "remove_niqqud": true, "remove_punctuation": true},
  "structure": {
    "chapter_heading": "h2",
    "explicit_unit_heading": "h3",
    "fallback_unit_separator": "jsx_br_pair",
    "discard_headings": ["h1"],
    "minimum_unit_characters": 2
  },
  "evidence": {"source": "observed_in_input", "literal": "observed_literal", "interpretation": ["inferred", "unknown"]},
  "lexicons": {
    "operations": {
      "engrave": ["חקק", "חקקן"], "carve": ["חצב", "חצבן"], "weigh": ["שקל", "שקלן"],
      "permute": ["המיר", "המירן"], "combine": ["צרף", "צרפן"], "form": ["צר", "יצר"],
      "crown": ["המליך"], "bind": ["קשר"], "seal": ["חתם"], "create": ["ברא"],
      "establish": ["יסד", "יסדן"], "examine": ["בחן", "בחון"], "investigate": ["חקור"], "stabilize": ["העמד"]
    },
    "domains": {"world": ["עולם", "בעולם", "עולמו"], "year": ["שנה", "בשנה"], "soul": ["נפש", "בנפש"]},
    "classes": {"mothers": ["אמות"], "doubles": ["כפולות"], "simples": ["פשוטות"], "sefirot": ["ספירות"], "letters": ["אותיות"], "paths": ["נתיבות"], "gates": ["שערים"]}
  },
  "numbers": [["שלשים ושתים",32],["שלושים ושתים",32],["עשרים ושתים",22],["עשרים ושתיים",22],["שתים עשרה",12],["שתיים עשרה",12],["שנים עשר",12],["שלוש",3],["שלש",3],["שבע",7],["עשר",10],["רלא",231]],
  "record_patterns": [{"id":"crowned_letter_mapping","trigger":"המליך אות","minimum_repetitions_to_split":2,"input_after":"אות","output_domains":["world","year","soul"],"governs_by_input":{"א":"רוח","מ":"מים","ש":"אש","ב":"חיים","ג":"שלום","ד":"חכמה","כ":"עושר","פ":"חן","ר":"זרע","ת":"ממשלה","ה":"ראיה","ו":"שמיעה","ז":"ריחה","ח":"שיחה","ט":"לעיטה","י":"תשמיש","ל":"מעשה","נ":"הלוך","ס":"רוגז","ע":"שחוק","צ":"הרהור","ק":"שינה"},"governs_source_forms":{"עושר":["עושר","עשר"],"רוגז":["רוגז","רגז"],"שינה":["שינה","שנה"]},"evidence":"inferred"}],
  "validation": {"require_chapter": true, "unique_ids": true, "reject_marker_leaks": true, "verify_stats": true, "allowed_evidence": ["observed_in_input", "observed_literal", "inferred", "unknown", "none"]}
}
