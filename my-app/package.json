{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "generate:source-map": "node scripts/generate-source-map.mjs",
    "test:source-map": "node scripts/generate-source-map.mjs --check",
    "generate:reading-units": "node scripts/generate-reading-units.mjs",
    "test:reading-units": "node scripts/generate-reading-units.mjs --check",
    "generate:reading-hierarchy": "node scripts/generate-reading-hierarchy.mjs",
    "test:reading-hierarchy": "node scripts/generate-reading-hierarchy.mjs --check",
    "generate:text-projection": "node scripts/generate-text-projection.mjs",
    "test:text-projection": "node scripts/generate-text-projection.mjs --check",
    "generate:text-context": "node scripts/generate-text-context.mjs",
    "test:text-context": "node scripts/generate-text-context.mjs --check",
    "generate:corpus-scope": "node scripts/generate-corpus-scope.mjs",
